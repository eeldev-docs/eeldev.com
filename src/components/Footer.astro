---
import { sitePath } from '../site-path.js';

const links = [
  ['Help', sitePath('/help/')], ['Contact', sitePath('/contact/')],
  ['Tutorials', 'https://www.youtube.com/@eeldev'], ['Discord', 'https://discord.gg/3Yu7pEy'],
  ['Fab', 'https://www.fab.com/sellers/eelDev']
];
---
<footer><div class="wrap foot">
  <a class="brand" href={sitePath('/')} aria-label="eelDev home"><i>&lt;</i>eelDev<i>/&gt;</i></a>
  <nav aria-label="Footer">
    {links.map(([label, href]) => href.startsWith('http')
      ? <a href={href}>{label} <span aria-hidden="true">↗</span></a>
      : <a href={href}>{label}</a>)}
  </nav>
  <p class="copy">© 2017–{new Date().getFullYear()} eelDev · Northern Sweden</p>
</div></footer>
