---
import Base from './Base.astro';
interface Props { title: string; description: string; noindex?: boolean }
const { title, description, noindex } = Astro.props;
---
<Base title={`${title} — eelDev`} description={description} noindex={noindex}>
  <main id="content" class="wrap info"><h1>{title}</h1><slot /></main>
</Base>
