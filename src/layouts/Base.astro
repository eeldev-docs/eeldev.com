---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { sitePath } from '../site-path.js';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  skipTo?: string;
  skipLabel?: string;
  noindex?: boolean;
}
const { title, description, skipTo = '#content', skipLabel = 'Skip to content', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0c1320" />
    <link rel="icon" href={sitePath('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="eelDev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href={skipTo}>{skipLabel}</a>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
