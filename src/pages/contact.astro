---
import Info from '../layouts/Info.astro';
import { sitePath } from '../site-path.js';
---
<Info title="Contact">
  <p class="lead">Have a question about an eelDev plugin? Join the community on Discord for product questions and support.</p>
  <a class="cta" href="https://discord.gg/3Yu7pEy">Join Discord ↗</a>
  <section><h2>Email</h2>
    <p><a href="mailto:support@eeldev.com">support@eeldev.com</a></p>
  </section>
  <section><h2>Product support</h2>
    <p><a href={sitePath('/help/')}>Read the support guide</a> for support hours, purchase verification and which logs to include with your request.</p>
  </section>
  <section><h2>Other channels</h2>
    <p><a href="https://www.youtube.com/@eeldev">Tutorials on YouTube ↗</a></p>
    <p><a href="https://x.com/dryeeldev">@dryeeldev on X ↗</a></p>
  </section> 
</Info>
