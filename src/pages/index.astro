---
// Home: short intro with a featured plugin, a sticky search/category bar, and plugin tiles grouped by category.
import { plugins } from '../data/plugins.js';
import Base from '../layouts/Base.astro';
import { sitePath } from '../site-path.js';

const order = ['Online', 'Gameplay', 'Editor', 'Cloud'];
const groups = order.map(name => ({ name, id: name.toLowerCase(), items: plugins.filter(p => p.category === name) }));
const featured = plugins.find(p => p.name === 'Host Migration Core')!;
const organization = {
  '@context': 'https://schema.org', '@type': 'Organization', name: 'eelDev',
  url: Astro.site?.href, foundingDate: '2017',
  sameAs: ['https://www.youtube.com/@eeldev', 'https://x.com/dryeeldev', 'https://www.fab.com/sellers/eelDev', 'https://github.com/eeldev-ue4']
};
---
<Base title="eelDev — Unreal Engine plugins" description="Discover eelDev plugins for Unreal Engine. Explore multiplayer integrations, gameplay systems and editor tools, and find their documentation." skipTo="#catalog" skipLabel="Skip to plugins">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(organization)} />
  <main class="home">
    <section class="wrap strip">
      <div>
        <p class="label"><b></b> Independent Unreal Engine tools since 2017</p>
        <h1>Unreal Engine plugins for <em>multiplayer</em>, gameplay and editor workflows.</h1>
        <p class="lead">{plugins.length} plugins with documentation and example projects. Support on Discord.</p>
      </div>
      <a class="spot" href={featured.url}>
        <span class="label">Featured plugin</span>
        <img src={sitePath(featured.image)} width="320" height="180" alt="" fetchpriority="high" />
        <span class="body">
          <strong>{featured.name}</strong>
          <span class="desc">{featured.description}</span>
          <span class="more">Read the docs <span aria-hidden="true">↗</span></span>
        </span>
      </a>
    </section>

    <div class="bar-wrap" id="catalog">
      <div class="wrap toolbar" role="search" aria-label="Filter plugins">
        <label class="search"><span class="sr">Search plugins</span><input type="search" id="q" placeholder="Search plugins…" /></label>
        <fieldset>
          <legend class="sr">Category</legend>
          <label><input type="radio" name="cat" value="All" checked /> All <span>{plugins.length}</span></label>
          {groups.map(g => <label><input type="radio" name="cat" value={g.name} /><i class={`dot ${g.id}`} aria-hidden="true"></i> {g.name} <span>{g.items.length}</span></label>)}
        </fieldset>
        <p id="status" class="result" aria-live="polite">{plugins.length} plugins</p>
      </div>
    </div>

    <section class="wrap catalog" aria-label="Plugins">
      {groups.map(g => (
        <section class="group" data-section aria-labelledby={`h-${g.id}`}>
          <h2 id={`h-${g.id}`}><i class={`dot ${g.id}`} aria-hidden="true"></i>{g.name}<span>{g.items.length}</span></h2>
          <div class="grid">
            {g.items.map(p => (
              <a class="tile" href={p.url} data-item data-group={g.name}>
                <img src={sitePath(p.image)} width="320" height="180" alt="" loading="lazy" decoding="async" />
                <span class="body"><strong>{p.name}</strong><span class="desc">{p.description}</span></span>
              </a>
            ))}
          </div>
        </section>
      ))}
      <p id="empty" hidden>No matching plugins. Try another name or category.</p>
    </section>
  </main>
  <script>
    const q = document.querySelector<HTMLInputElement>('#q')!;
    const items = document.querySelectorAll<HTMLElement>('[data-item]');
    const sections = document.querySelectorAll<HTMLElement>('[data-section]');
    const status = document.querySelector('#status')!;
    const empty = document.querySelector<HTMLElement>('#empty')!;
    function run() {
      const cat = document.querySelector<HTMLInputElement>('input[name=cat]:checked')!.value;
      const text = q.value.toLowerCase().trim();
      let n = 0;
      for (const el of items) {
        el.hidden = (cat !== 'All' && el.dataset.group !== cat) || !el.textContent!.toLowerCase().includes(text);
        if (!el.hidden) n++;
      }
      for (const s of sections) s.hidden = !s.querySelector('[data-item]:not([hidden])');
      status.textContent = n === 1 ? '1 plugin' : `${n} plugins`;
      empty.hidden = n > 0;
    }
    document.querySelectorAll('input[name=cat], #q').forEach(i => i.addEventListener('input', run));
  </script>
</Base>

<style>
  .home { padding-bottom: 72px }
  .strip { display: grid; grid-template-columns: 1.5fr 1fr; gap: 48px; align-items: center; padding-block: clamp(36px, 5vw, 64px) }
  .strip .label { color: var(--muted) }
  h1 { font-size: clamp(30px, 3.4vw, 48px); line-height: 1.15; margin: 16px 0; letter-spacing: -.035em; text-wrap: balance }
  h1 em { font-style: normal }
  .lead { font-size: 17px }

  .spot { display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 8px 18px; padding: 20px; background: var(--surface); border: 1px solid var(--line); border-radius: 12px }
  .spot:hover { border-color: var(--accent) }
  .spot .label { grid-column: 1 / -1; color: var(--accent); margin-bottom: 6px }
  .spot img { width: 160px }
  .spot strong { font-size: 22px }
  .more { font-size: 14px; font-weight: 650; color: var(--accent); margin-top: 4px }

  img { display: block; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 8px; background: var(--surface-2); max-width: 100% }

  .bar-wrap { position: sticky; top: 0; z-index: 5; background: var(--bg); border-block: 1px solid var(--line); scroll-margin-top: 0 }
  .toolbar { display: flex; align-items: center; gap: 16px; padding-block: 12px }
  .search input { width: 240px }
  fieldset { border: 0; padding: 0; margin: 0; display: flex; gap: 6px; min-width: 0 }
  fieldset label { position: relative; flex: none; display: flex; align-items: center; gap: 8px; padding: 7px 13px; border: 1px solid var(--line); border-radius: 30px; font-size: 14px; cursor: pointer }
  fieldset label:hover { border-color: var(--muted) }
  fieldset label:has(:checked) { background: var(--fg); color: var(--bg); border-color: var(--fg) }
  fieldset label:has(:focus-visible) { outline: 3px solid var(--focus); outline-offset: 2px }
  fieldset span { font: 12px var(--mono); opacity: .75 }
  input[type=radio] { position: absolute; inset: 0; margin: 0; opacity: 0; pointer-events: none }
  .result { margin-left: auto; font: 12px var(--mono); color: var(--muted); letter-spacing: .08em; text-transform: uppercase; white-space: nowrap }
  .dot { width: 8px; height: 8px; border-radius: 2px; flex: none }
  .online { background: var(--cat-online) } .gameplay { background: var(--cat-gameplay) } .editor { background: var(--cat-editor) } .cloud { background: var(--cat-cloud) }

  .group { padding-top: 36px }
  .group h2 { display: flex; align-items: center; gap: 10px; font-size: 22px; letter-spacing: -.03em; margin-bottom: 14px }
  .group h2 .dot { width: 10px; height: 10px }
  .group h2 span { font: 12px var(--mono); color: var(--muted) }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 12px }
  .tile { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 16px; align-items: center; padding: 14px; background: var(--surface); border: 1px solid var(--line); border-radius: 10px }
  .tile:hover { border-color: var(--accent) }
  .tile:hover strong { color: var(--accent) }
  .tile img { width: 112px; border-radius: 6px }
  .body { display: grid; gap: 4px; align-content: start }
  strong { font-weight: 600; font-size: 17px; letter-spacing: -.02em }
  .desc { color: var(--muted); font-size: 14px; line-height: 1.5 }
  #empty { color: var(--muted); padding-top: 24px }

  @media (max-width: 860px) {
    .strip { grid-template-columns: 1fr; gap: 24px }
    .toolbar { flex-wrap: wrap; gap: 10px }
    .search { flex: 1 1 100% }
    .search input { width: 100% }
    fieldset { flex: 1 1 100%; overflow-x: auto; scrollbar-width: none }
    .result { display: none }
    .group { padding-top: 26px }
    .tile { grid-template-columns: 96px minmax(0, 1fr); gap: 12px; padding: 12px }
    .tile img { width: 96px }
    .spot { grid-template-columns: 120px minmax(0, 1fr) }
    .spot img { width: 120px }
  }
</style>
