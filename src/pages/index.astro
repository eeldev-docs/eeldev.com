---
import { plugins } from '../data/plugins.js';
import Base from '../layouts/Base.astro';
const featured = plugins.find(p => p.name === 'Host Migration Core');
const categories = ['All', ...new Set(plugins.map(p => p.category))];
const organization = {
  '@context': 'https://schema.org', '@type': 'Organization', name: 'eelDev',
  url: Astro.site?.href, foundingDate: '2017',
  sameAs: ['https://www.youtube.com/@eeldev', 'https://x.com/dryeeldev', 'https://www.fab.com/sellers/eelDev', 'https://github.com/eeldev-ue4']
};
---
<Base title="eelDev — Unreal Engine plugins" description="Discover eelDev plugins for Unreal Engine. Explore multiplayer integrations, gameplay systems and editor tools, and find their documentation." skipTo="#catalog" skipLabel="Skip to plugins">
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(organization)} />
    <main>
      <section class="hero wrap">
        <div class="intro">
          <p class="label"><b></b> Independent Unreal Engine tools</p>
          <h1>Build your<br/>next <em>game.</em></h1>
          <p class="lead">Multiplayer integrations, gameplay systems and editor tools for Unreal Engine developers.</p>
          <a class="cta" href="#catalog">Browse plugins <span aria-hidden="true">↓</span></a>
        </div>
        <article class="feature">
          <div class="panel-top"><span>Multiplayer lab</span><span>Listen server</span></div>
          <div class="network" role="img" aria-label="Illustrated listen-server session with one host and two connected players">
            <div class="wires"></div>
            <div class="node host"><i>01</i><small>Host</small></div>
            <div class="node peer left"><i>02</i><small>Player</small></div>
            <div class="node peer right"><i>03</i><small>Player</small></div>
          </div>
          <div class="panel-foot"><div><p class="label">Featured plugin</p><h2>{featured.name}</h2></div><a href={featured.url} aria-label={`Explore ${featured.name}`}>↗</a></div>
        </article>
      </section>
      <section class="library" id="catalog"><div class="wrap">
        <div class="section-head"><h2>Plugin library<span>.</span></h2><label hidden id="search-label"><span class="sr">Search plugins</span><input type="search" id="query" placeholder="Search plugins…" /></label></div>
        <div id="filters" hidden aria-label="Filter by category" role="group">{categories.map((name,i) => <button type="button" aria-pressed={i===0} data-category={name}>{name}</button>)}</div>
        <p id="status" class="sr" aria-live="polite"></p>
        <div class="cards">{plugins.map(p => <a class="card" data-group={p.category} href={p.url}><span class="label cat">{p.category}</span><h3>{p.name}</h3><p>{p.description}</p><span class="doc">Documentation <span aria-hidden="true">↗</span></span></a>)}</div>
        <p id="empty" hidden>No matching plugins. Try another name or category.</p>
      </div></section>
    </main>
    <script>
      const input = document.querySelector<HTMLInputElement>('#query')!;
      const buttons = document.querySelectorAll<HTMLButtonElement>('#filters button');
      const cards = document.querySelectorAll<HTMLElement>('.card');
      let category = 'All';
      function filter() {
        const query = input.value.toLowerCase().trim();
        let count = 0;
        for (const card of cards) {
          card.hidden = (category !== 'All' && category !== card.dataset.group) || !card.textContent!.toLowerCase().includes(query);
          if (!card.hidden) count++;
        }
        document.querySelector<HTMLElement>('#empty')!.hidden = count > 0;
        document.querySelector('#status')!.textContent = count === 1 ? '1 matching plugin' : count + ' matching plugins';
      }
      for (const button of buttons) button.addEventListener('click', () => {
        category = button.dataset.category!;
        for (const item of buttons) item.setAttribute('aria-pressed', String(item === button));
        filter();
      });
      input.addEventListener('input', filter);
      for (const id of ['filters','search-label']) document.getElementById(id)!.hidden = false;
    </script>
</Base>
